# Copie para `.env` e preencha. O `.env` nunca vai para o Git.
# Variáveis já definidas no ambiente (systemd, Docker…) têm prioridade sobre este arquivo.

# ───── Discord Activity ─────
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ───── Servidor de produção (npm run serve) ─────

# Onde o servidor escuta. Atrás do Caddy, deixe 127.0.0.1 para não expor a porta 3000 diretamente.
PORT=3000
HOST=0.0.0.0

# ───── Segurança ─────

# Segredo que assina os tokens de sessão da API (use um valor longo e aleatório, ex.: `openssl rand -hex 32`).
# Sem ele, um segredo novo nasce a cada início do servidor e os tokens valem só até o próximo reinício.
SESSION_SECRET=

# Origens (além da própria) autorizadas a chamar a API e abrir o WebSocket, separadas por vírgula.
# Padrão: só a própria origem + a Discord Activity (https://<VITE_DISCORD_CLIENT_ID>.discordsays.com).
# Exemplo: ALLOWED_ORIGINS=https://lunio.exemplo.com,https://outro.exemplo.com
ALLOWED_ORIGINS=

# Ligue (1) quando o servidor roda atrás de proxy reverso (Caddy, nginx): o IP do cliente passa a vir
# do X-Forwarded-For, que é o que o rate limit usa. Sem proxy na frente, deixe desligado.
TRUST_PROXY=

# SÓ PARA DESENVOLVIMENTO/TESTES: deixa o proxy buscar endereços de rede interna (127.0.0.1, 192.168.x…).
# Em produção, mantenha vazio: é o que impede o servidor de ser usado para alcançar a rede interna.
ALLOW_PRIVATE_URLS=

# ───── Envios e disco ─────

# Cota total de disco para os arquivos enviados (pasta .uploads/), em GB.
MAX_UPLOAD_DISK_GB=20
# Tamanho máximo de um único envio, em GB.
MAX_UPLOAD_FILE_GB=50
# Quantas horas um envio continua no disco depois que a sala dele é encerrada.
UPLOAD_TTL_HOURS=6
# Limite da pasta .cache/ (legendas, fontes e os segmentos HLS do áudio alternativo), em GB. Acima disso apaga o que foi
# usado há mais tempo. Cada áudio alternativo assistido guarda, em segmentos, aproximadamente o tamanho do arquivo.
MAX_CACHE_GB=10

# ───── Processos ─────

# Quantos FFmpeg/Python podem rodar ao mesmo tempo no servidor inteiro (cada troca de áudio ocupa um).
MAX_FFMPEG_PROCS=8
# Caminho do Python (≥ 3.10) usado pelo extrator de legendas. Padrão: `python`.
PYTHON_PATH=
