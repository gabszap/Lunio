# Copy to `.env` and fill in. The `.env` never goes into Git.
# Variables already defined in the environment (systemd, Docker...) take priority over this file.

# ───── Discord Activity ─────
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ───── Production server (npm run serve) ─────

# Where the server listens. Behind Caddy, leave 127.0.0.1 so port 3000 is not directly exposed.
PORT=3000
HOST=0.0.0.0

# ───── Security ─────

# Secret that signs the API session tokens (use a long random value, e.g. `openssl rand -hex 32`).
# Without it, a new secret is created on every server start and tokens only last until the next restart.
SESSION_SECRET=

# Origins (besides the app's own) allowed to call the API and open the WebSocket, comma-separated.
# Default: only the app's own origin + the Discord Activity (https://<VITE_DISCORD_CLIENT_ID>.discordsays.com).
# Example: ALLOWED_ORIGINS=https://lunio.example.com,https://other.example.com
ALLOWED_ORIGINS=

# Turn on (1) when the server runs behind a reverse proxy (Caddy, nginx): the client IP is then taken
# from X-Forwarded-For, which is what the rate limit uses. Without a proxy in front, leave it off.
TRUST_PROXY=

# DEVELOPMENT/TESTING ONLY: lets the proxy fetch addresses on the internal network (127.0.0.1, 192.168.x…).
# In production, keep it empty: this is what prevents the server from being used to reach the internal network.
ALLOW_PRIVATE_URLS=

# ───── Uploads and disk ─────

# Total disk quota for uploaded files (the .uploads/ folder), in GB.
MAX_UPLOAD_DISK_GB=20
# Maximum size of a single upload, in GB.
MAX_UPLOAD_FILE_GB=50
# Size of each piece of a chunked upload, in MB. Fewer pieces = fewer requests for big files
# (the server rate limit allows ~50 GB in pieces of this size). The server hard-caps a piece at 96 MB.
UPLOAD_CHUNK_MB=64
# How many hours an upload stays on disk after its room is closed.
UPLOAD_TTL_HOURS=24
# Minimum free space on the machine's disk, in GB: a new upload is refused (507) if the disk would
# fall below this after it lands. The cache, the system and everything else need the headroom.
MIN_FREE_DISK_GB=5
# Limit of the .cache/ folder (subtitles, fonts and the HLS segments of the alternative audio), in GB. Beyond that,
# it evicts whichever files were used longest ago. Each alternative audio watched stores, in segments,
# roughly the size of the file.
MAX_CACHE_GB=10

# Optional URL of a local Redis. With it: (1) rooms survive a server restart (host, bans, queue, video and
# position are saved and restored; chat and who is connected are not), and (2) the upload index (last read,
# rooms, marks) lives in Redis and is rebuilt from disk on startup. Without it, rooms drop on a restart and the
# uploads work on disk alone. Redis is not the source of truth and none of its failures block anything:
# 300 ms ceiling per call, otherwise fall back. Run it in RAM only, bound to 127.0.0.1.
# Example (local container): REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
# How long a room's saved state is valid in Redis (hours).
ROOM_STATE_TTL_HOURS=24
# After a restart, how long the previous host has to come back before another member takes over (seconds).
ROOM_HOST_GRACE_SECONDS=60

# ───── Processes ─────

# How many FFmpeg/Python processes may run at the same time across the whole server (each audio switch takes one).
MAX_FFMPEG_PROCS=8
# Path to Python (>= 3.10) used by the subtitle extractor. Default: `python`.
PYTHON_PATH=
